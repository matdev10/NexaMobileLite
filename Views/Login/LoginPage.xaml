<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NexaMobileLite.Views.Login.LoginPage"
    BackgroundColor="#050B18"
    Title="Login">

    <Grid Padding="28">

        <VerticalStackLayout
            Spacing="22"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="NEXA"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Mobile Lite"
                    FontSize="16"
                    TextColor="#38BDF8"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="ERP operativo móvil"
                    FontSize="12"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border
                Stroke="#1E293B"
                StrokeThickness="1"
                BackgroundColor="#0F172A"
                Padding="24"
                StrokeShape="RoundRectangle 28">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Iniciar sesión"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Entry
                        x:Name="UsuarioEntry"
                        Placeholder="Usuario"
                        PlaceholderColor="#64748B"
                        TextColor="White"
                        BackgroundColor="#111827" />

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Contraseña"
                        IsPassword="True"
                        PlaceholderColor="#64748B"
                        TextColor="White"
                        BackgroundColor="#111827" />

                    <Button
                        Text="Ingresar"
                        HeightRequest="52"
                        CornerRadius="18"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="BtnIngresar_Clicked" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Powered by Zeezton / Nexa"
                FontSize="11"
                TextColor="#475569"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>