<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:NexaMobileLite.ViewModels"
    x:Class="NexaMobileLite.Views.Inventario.InventarioPage"
    BackgroundColor="#050B18"
    Title="Inventario">

    <ContentPage.BindingContext>
        <viewmodels:InventarioViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">

            <Label Text="Inventario"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Label Text="Productos conectados desde Zeezton Store"
                   FontSize="14"
                   TextColor="#94A3B8" />

            <ActivityIndicator
                IsRunning="{Binding EstaCargando}"
                IsVisible="{Binding EstaCargando}"
                Color="#38BDF8" />

            <CollectionView ItemsSource="{Binding Productos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#0F172A"
                                Stroke="#1E293B"
                                StrokeThickness="1"
                                Padding="14"
                                Margin="0,0,0,12"
                                StrokeShape="RoundRectangle 24">

                            <Grid ColumnDefinitions="90,*"
                                  ColumnSpacing="14">

                                <Image Source="{Binding Imagen}"
                                       WidthRequest="90"
                                       HeightRequest="90"
                                       Aspect="AspectFill" />

                                <VerticalStackLayout Grid.Column="1" Spacing="5">

                                    <Label Text="{Binding Nombre}"
                                           TextColor="White"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <Label Text="{Binding Marca}"
                                           TextColor="#94A3B8"
                                           FontSize="13" />

                                    <Label Text="{Binding Precio, StringFormat='${0:N0}'}"
                                           TextColor="#38BDF8"
                                           FontSize="16"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                           TextColor="#A7F3D0"
                                           FontSize="13" />

                                    <Label Text="{Binding EstadoStockDisplay}"
                                           TextColor="#FACC15"
                                           FontSize="13"
                                           FontAttributes="Bold" />

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>