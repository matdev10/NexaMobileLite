<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NexaMobileLite.Views.Pedidos.PedidosPage"
    BackgroundColor="#050B18"
    Title="Pedidos">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Pedidos"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label Text="Consulta y seguimiento de pedidos"
                       FontSize="14"
                       TextColor="#94A3B8"/>
            </VerticalStackLayout>

            <SearchBar Placeholder="Buscar pedido..."
                       BackgroundColor="#0F172A"
                       PlaceholderColor="#64748B"
                       TextColor="White"/>

            <CollectionView ItemsSource="{Binding Pedidos}">
                <CollectionView.EmptyView>
                    <Border BackgroundColor="#0F172A"
                            Stroke="#1E293B"
                            StrokeThickness="1"
                            Padding="25"
                            StrokeShape="RoundRectangle 24">

                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="📦"
                                   FontSize="48"
                                   HorizontalOptions="Center"/>

                            <Label Text="No existen pedidos"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"/>

                            <Label Text="Cuando existan pedidos aparecerán aquí."
                                   FontSize="14"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#0F172A"
                                Stroke="#1E293B"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,0,12"
                                StrokeShape="RoundRectangle 24">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label Text="{Binding ClienteNombre}"
                                       FontSize="14"
                                       TextColor="#94A3B8"/>

                                <Label Text="{Binding EstadoTexto}"
                                       FontSize="13"
                                       TextColor="#38BDF8"/>

                                <Label Text="{Binding Total, StringFormat='Total: ${0:N0}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label Text="{Binding Creado}"
                                       FontSize="12"
                                       TextColor="#64748B"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>